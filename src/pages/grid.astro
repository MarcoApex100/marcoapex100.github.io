---
import MainLayout from "../layouts/MainLayout.astro";
import bookCover from "../assets/book-cover.png";
---

<MainLayout title="Join The Grid | Marco Apex">
  <div
    class="cover-background cover-background-left"
    style={`background-image: url(${bookCover.src});`}
    aria-hidden="true"
  ></div>

  <div
    class="cover-background cover-background-right"
    style={`background-image: url(${bookCover.src});`}
    aria-hidden="true"
  ></div>

  <main class="grid-page">
    <section class="grid-card">
      <p class="eyebrow">MARCO APEX</p>
      <h1>Join The Grid</h1>

      <p class="bio">
        Subscribe to The Grid for updates from Marco Apex on new books, behind-the-scenes insight and the stories shaping future projects. You’ll also be first to hear about exclusive releases and special offers created for readers who want to stay closer to the craft.
      </p>

      <a
        class="join-button"
        href="https://marco-apex.kit.com/d6192121e3"
        target="_blank"
        rel="noopener noreferrer"
      >
        Join The Grid
      </a>

      <p class="privacy-note">
        Opens the secure Kit signup form. You can unsubscribe at any time.
      </p>

      <div class="divider"></div>

      <a class="back-link" href="/review/">← Back to reader page</a>

      <p class="signature">
        Thank you for being part of the journey.<br />
        <strong>— Marco Apex</strong>
      </p>
    </section>
  </main>
</MainLayout>

<style>
.cover-background{
  position:fixed;
  top:0;
  width:min(30vw,420px);
  height:100vh;
  background-position:center;
  background-repeat:no-repeat;
  background-size:cover;
  pointer-events:none;
  z-index:0;
}

.cover-background-right{
  right:0;
  opacity:.14;
  -webkit-mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.25) 28%,black 100%);
  mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.25) 28%,black 100%);
}

.cover-background-left{
  left:0;
  opacity:.07;
  transform:scaleX(-1);
  -webkit-mask-image:linear-gradient(to left,transparent 0%,rgba(0,0,0,.25) 28%,black 100%);
  mask-image:linear-gradient(to left,transparent 0%,rgba(0,0,0,.25) 28%,black 100%);
}

.grid-page{
  position:relative;
  z-index:1;
  min-height:100vh;
  display:grid;
  place-items:center;
  width:min(100% - 36px,760px);
  margin:0 auto;
  padding:70px 0;
}

.grid-card{
  width:100%;
  text-align:center;
  border:1.5px solid rgba(255,255,255,.92);
  border-radius:22px;
  padding:48px 32px;
  background:rgba(255,255,255,.02);
}

.eyebrow{
  color:var(--accent);
  font-size:.78rem;
  font-weight:700;
  letter-spacing:3px;
  text-transform:uppercase;
  margin:0 0 18px;
}

h1{
  font-size:clamp(3rem,8vw,5.7rem);
  line-height:1;
  margin:0 0 24px;
}

.bio{
  max-width:620px;
  margin:0 auto 34px;
  font-size:1.08rem;
  line-height:1.75;
  opacity:.68;
}

.join-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:230px;
  min-height:58px;
  padding:15px 28px;
  color:#ffd84d;
  background:transparent;
  border:2px solid #ffd84d;
  border-radius:999px;
  font-weight:700;
  text-decoration:none;
  cursor:pointer;
  position:relative;
  z-index:10;
  box-shadow:0 0 0 1px rgba(255,216,77,.22),0 0 16px rgba(255,216,77,.08);
  transition:transform .2s ease,background .2s ease,color .2s ease,box-shadow .2s ease;
}

.join-button:hover{
  transform:translateY(-2px);
  background:#ffd84d;
  color:#111;
  box-shadow:0 0 20px rgba(255,216,77,.22);
}

.privacy-note{
  margin:14px auto 0;
  font-size:.78rem;
  line-height:1.55;
  opacity:.55;
}

.divider{
  width:100%;
  height:1px;
  margin:58px 0 34px;
  background:linear-gradient(to right,transparent,rgba(255,255,255,.2),transparent);
}

.back-link{
  display:inline-block;
  color:inherit;
  text-decoration:none;
  opacity:.75;
}

.back-link:hover{
  opacity:1;
}

.signature{
  margin:36px 0 0;
  line-height:1.8;
  opacity:.68;
}

@media (max-width:700px){
  .cover-background{
    width:100%;
    height:55vh;
    opacity:.07;
    background-position:center top;
    -webkit-mask-image:linear-gradient(to bottom,black 0%,transparent 100%);
    mask-image:linear-gradient(to bottom,black 0%,transparent 100%);
  }

  .grid-page{
    width:min(100% - 28px,760px);
    padding:56px 0 64px;
  }

  .grid-card{
    padding:34px 20px;
    border-radius:18px;
  }

  .join-button{
    width:min(100%,360px);
  }
}
</style>