---
import MainLayout from "../layouts/MainLayout.astro";
import bookCover from "../assets/book-cover.png";
---

<MainLayout title="Join The Grid | Marco Apex">
  <div
    class="cover-background cover-background-left"
    style={`background-image: url(${bookCover.src});`}
    aria-hidden="true"
  ></div>

  <div
    class="cover-background cover-background-right"
    style={`background-image: url(${bookCover.src});`}
    aria-hidden="true"
  ></div>

  <main class="grid-page">
    <section class="grid-card">
      <p class="eyebrow">MARCO APEX</p>
      <h1>Join The Grid</h1>

      <p class="intro">
        Join The Grid to receive updates on new books and exclusive special offers before anyone else.
      </p>

      <form id="grid-form" class="signup-form" action="#" method="post">
        <label for="email">Email address</label>
        <div class="form-row">
          <input
            id="email"
            name="email_address"
            type="email"
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
            required
          />
          <button type="submit">Join The Grid</button>
        </div>

        <p class="privacy-note">
          By joining, you agree to receive email updates from Marco Apex. You can unsubscribe at any time.
        </p>

        <p id="form-message" class="form-message" role="status" aria-live="polite"></p>
      </form>

      <div class="divider"></div>

      <a class="back-link" href="/review/">← Back to reader page</a>

      <p class="signature">
        Thank you for being part of the journey.<br />
        <strong>— Marco Apex</strong>
      </p>
    </section>
  </main>

  <script>
    const form = document.getElementById("grid-form");
    const message = document.getElementById("form-message");

    form?.addEventListener("submit", (event) => {
      if (form.getAttribute("action") === "#") {
        event.preventDefault();
        if (message) {
          message.textContent = "Email signup is being connected. Please check back shortly.";
        }
      }
    });
  </script>
</MainLayout>

<style>
.cover-background{
  position:fixed;
  top:0;
  width:min(30vw,420px);
  height:100vh;
  background-position:center;
  background-repeat:no-repeat;
  background-size:cover;
  pointer-events:none;
  z-index:0;
}

.cover-background-right{
  right:0;
  opacity:.14;
  -webkit-mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.25) 28%,black 100%);
  mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.25) 28%,black 100%);
}

.cover-background-left{
  left:0;
  opacity:.07;
  transform:scaleX(-1);
  -webkit-mask-image:linear-gradient(to left,transparent 0%,rgba(0,0,0,.25) 28%,black 100%);
  mask-image:linear-gradient(to left,transparent 0%,rgba(0,0,0,.25) 28%,black 100%);
}

.grid-page{
  position:relative;
  z-index:1;
  min-height:100vh;
  display:grid;
  place-items:center;
  width:min(100% - 36px,760px);
  margin:0 auto;
  padding:70px 0;
}

.grid-card{
  width:100%;
  text-align:center;
}

.eyebrow{
  color:var(--accent);
  font-size:.78rem;
  font-weight:700;
  letter-spacing:3px;
  text-transform:uppercase;
  margin:0 0 18px;
}

h1{
  font-size:clamp(3rem,8vw,5.7rem);
  line-height:1;
  margin:0 0 24px;
}

.intro{
  max-width:620px;
  margin:0 auto 38px;
  font-size:1.12rem;
  line-height:1.75;
  opacity:.84;
}

.signup-form{
  width:min(100%,620px);
  margin:0 auto;
}

.signup-form label{
  display:block;
  margin-bottom:10px;
  text-align:left;
  font-size:.9rem;
  font-weight:700;
}

.form-row{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:12px;
}

input{
  min-height:58px;
  width:100%;
  padding:0 18px;
  color:inherit;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.18);
  border-radius:10px;
  font:inherit;
  outline:none;
}

input:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 1px var(--accent);
}

button{
  min-height:58px;
  padding:0 26px;
  border:1px solid var(--accent);
  border-radius:10px;
  background:var(--accent);
  color:#111;
  font:inherit;
  font-weight:800;
  cursor:pointer;
  transition:transform .2s ease,filter .2s ease;
}

button:hover{
  transform:translateY(-2px);
  filter:brightness(1.06);
}

.privacy-note{
  margin:14px auto 0;
  font-size:.78rem;
  line-height:1.55;
  opacity:.55;
}

.form-message{
  min-height:24px;
  margin:16px 0 0;
  color:var(--accent);
  font-size:.9rem;
  font-weight:700;
}

.divider{
  width:100%;
  height:1px;
  margin:58px 0 34px;
  background:linear-gradient(to right,transparent,rgba(255,255,255,.2),transparent);
}

.back-link{
  display:inline-block;
  color:inherit;
  text-decoration:none;
  opacity:.75;
}

.back-link:hover{
  opacity:1;
}

.signature{
  margin:36px 0 0;
  line-height:1.8;
  opacity:.68;
}

@media (max-width:700px){
  .cover-background{
    width:100%;
    height:55vh;
    opacity:.07;
    background-position:center top;
    -webkit-mask-image:linear-gradient(to bottom,black 0%,transparent 100%);
    mask-image:linear-gradient(to bottom,black 0%,transparent 100%);
  }

  .grid-page{
    width:min(100% - 28px,760px);
    padding:56px 0 64px;
  }

  .form-row{
    grid-template-columns:1fr;
  }

  button{
    width:100%;
  }
}
</style>